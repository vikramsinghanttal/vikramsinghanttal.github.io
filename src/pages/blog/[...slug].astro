---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import InlineEmailSignupForm from "@/components/InlineEmailSignupForm.astro";
// Import KaTeX's own CSS (not a CDN link) so its version always matches the
// installed `katex` package that rehype-katex uses to render the markup.
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");
  return blogPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const description =
  post.data.description || "Views on Passion and Technology.";
---

<Base title={post.data.title} description={description} article>
  <div class="container-wide py-12 sm:py-16">
    <a href="/blog/" class="block text-[var(--color-accent)] dark:text-[var(--color-accent-dark)] hover:underline mb-6">
      ← Vikram's Blog
    </a>

    <article>
    <div class="mt-8">
      <InlineEmailSignupForm />
    </div>
      <time
        class="text-[var(--color-muted)] dark:text-[var(--color-muted-dark)] sm:text-xl"
        datetime={new Date(post.data.date).toISOString()}
      >
        {
          new Date(post.data.date).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
      <h1 class="mb-6 mt-2 text-2xl sm:text-4xl font-bold leading-tight">
        {post.data.title}
      </h1>
      <div class="prose-custom max-w-full sm:prose-lg">
        <Content />
      </div>
    </article>
        <div>
          <h2 class="font-bold text-2xl">Comments</h2>
          <script 
            is:inline
            src="https://giscus.app/client.js"
            data-repo="vikramsinghanttal/vikramsinghanttal.github.io"
            data-repo-id="R_kgDOUFrlFg"
            data-category="Blog Comments"
            data-category-id="DIC_kwDOUFrlFs4DGCGu"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="bottom"
            data-theme="preferred_color_scheme"
            data-lang="en"
            data-loading="lazy"
            crossorigin="anonymous"
            async>
          </script>
        </div>
  </div>
</Base>