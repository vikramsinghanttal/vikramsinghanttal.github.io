---

import { site } from '@/site.config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
function isActive(href: string) 
{
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}

import Wave from "./Wave.astro";
import NavLink from "./NavLink.astro";

interface Props 
{
  current: string;
  wavy?: boolean;
  waveClassName?: string;
}

const { current, wavy = true, waveClassName = undefined } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<header class:list={["bg-black dark:bg-[#2dd4bf] relative overflow-hidden", { "pb-3": wavy }]}>
  <div class="container-wide px-8 py-6 mx-auto flex items-center justify-between">
    <a href={`${base}/`} class="text-white dark:text-gray-900 text-xl font-medium underline decoration-transparent hover:decoration-green-400 dark:hover:decoration-green-700 decoration-wavy decoration-2 pb-1 -mb-1 underline-offset-4 hover:scale-110 hover:-rotate-3 transition-all">
      Vikram Singh
    </a>

    <nav class="flex items-center space-x-4">
      {
        site.nav.map((item) => {
          const active = isActive(item.href);
          const external = item.href.endsWith('.pdf');
          return (
            <NavLink
              href={item.href}
              aria-current={active ? 'page' : undefined}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              class:list={[
                'rounded-md px-3 py-1.5 transition-colors',
                active
                  ? 'text-[var(--color-accent)] dark:text-[var(--color-accent-dark)]'
                  : 'text-[var(--color-muted)] hover:text-[var(--color-subtle)] dark:text-[var(--color-muted-dark)] dark:hover:text-[var(--color-fg-dark)]',
              ]}
            >
              {item.label}
            </NavLink>
          );
        })
      }
      <ThemeToggle />
    </nav>
  </div>
  {wavy && <Wave className={waveClassName} />}
</header>