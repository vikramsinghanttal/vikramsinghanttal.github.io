---
interface Props {
  href: string;
  selected?: boolean;
}

const { href, selected = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    "text-white dark:text-gray-900 px-4 py-2 rounded-lg",
    { "hover:bg-[var(--color-subtle)] hover:text-[var(--color-fg)] dark:hover:bg-sky-200": !selected, "bg-indigo-800 dark:bg-sky-300": selected },
  ]}
>
  <slot />
</a>
